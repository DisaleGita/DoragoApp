{
  servers {
    protocols h1 h2 h3
  }
}

{$APP_DOMAIN} {
  encode zstd gzip

  @api path /api/*
  handle @api {
    request_body {
      max_size 30MB
    }
    reverse_proxy api:8000
  }

  handle {
    reverse_proxy flutter-web:8080
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
  }
}
