APP_ENV=development
APP_DOMAIN=localhost
API_PORT=8000
POSTGRES_DB=dorago
POSTGRES_USER=dorago
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://dorago:${POSTGRES_PASSWORD}@postgres:5432/dorago
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
OTP_HASH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
ENABLE_DEV_OTP_BYPASS=false
DEV_OTP_CODE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
STORAGE_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
STORAGE_BUCKET=dorago-documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_DOCUMENT_BYTES=15728640
